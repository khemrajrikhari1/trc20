# PostgreSQL connection
DATABASE_URL="postgresql://user:password@localhost:5432/trc20_studio?schema=public"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/trc20_studio?schema=public"

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Optional but strongly recommended for production rate limits: https://www.trongrid.io
TRONGRID_API_KEY=""

# Networks the UI allows. Mainnet stays hidden unless explicitly enabled.
NEXT_PUBLIC_ENABLED_NETWORKS="nile,shasta,mainnet"

# Public URL used in the sign-in message (prevents signature replay on other sites)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
